# ---- Build stage ----
FROM node:22-alpine AS build
WORKDIR /app

# Copy package files
COPY frontend/careeros-ui/package*.json ./
RUN npm install

# Copy source
COPY frontend/careeros-ui/ .

# Build
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine AS runtime

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built app
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
